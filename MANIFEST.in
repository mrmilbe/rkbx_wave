# Build a wheel with:  pip install --upgrade build  &&  python -m build --wheel

include LICENSE
include README.md

# The package + its bundled data (memory offsets + default config)
recursive-include rb_waveform_core *.py
include rb_waveform_core/data/offsets
include rb_waveform_core/data/default_config.json

# Keep experimental / maintenance code out of the distribution (stays in git)
prune rb_waveform_lab
prune rb_offset_detect

# Caches, envs, IDE, user state
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude *.pyd
prune rkbx_wavw_venv
prune TEST
global-exclude .git*
global-exclude *.swp
global-exclude *~
exclude last_config.txt
exclude profile.svg
exclude requirements.txt
